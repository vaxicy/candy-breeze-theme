  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#D7BDF2",
    "interface": "#D7BDF2",
    "enum": "#D7BDF2",
    "type": "#D7BDF2",
    "function": "#CFECF3",
    "method": "#CFECF3",
    "parameter": "#F5EFF7",
    "property": "#F5EFF7",
    "variable": "#F5EFF7"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#AAA1B8"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#F9B2D7"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#DAF9DE"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F6FFDC"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#D7BDF2"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#CFECF3"
      }
    },
    {
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#F5EFF7"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F9B2D7"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F6FFDC"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#F9B2D7"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F3A8B5"
      }
    }
  ]
